# Base URL of the backend API.
# Leave unset for local development — the app falls back to http://localhost:5000/api
# For production, set this to your deployed API, e.g.:
# VITE_API_URL=https://dentalappserver.onrender.com/api
VITE_API_URL=

# Mixpanel project token (Settings > Project Settings in Mixpanel).
# Leave unset to disable analytics entirely (e.g. local dev).
VITE_MIXPANEL_TOKEN=
