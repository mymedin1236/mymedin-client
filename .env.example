# Which deployment this build is for: "production" (default) or "staging".
# Selects the API, the analytics token and the staging marker — see
# src/config/env.js. Leave unset for local development.
VITE_APP_ENV=

# Base URL of the backend API. LOCAL DEVELOPMENT ONLY — a production build
# ignores this and picks its API from the allowlist in src/config/env.js, so a
# stray env value can't repoint a deployed app at another host.
# Unset locally -> http://localhost:5000/api
VITE_API_URL=

# Mixpanel project token (Settings > Project Settings in Mixpanel).
# Only ever used when VITE_APP_ENV is production, so staging and local traffic
# never reach the live project. Leave unset to disable analytics entirely.
VITE_MIXPANEL_TOKEN=
