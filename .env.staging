# Staging defaults, committed so the staging build is reproducible from the repo
# alone. Vite only reads this when built with `--mode staging`; the Vercel
# staging project instead sets VITE_APP_ENV=staging as a real environment
# variable, which overrides the .env files.
#
#   npm run build:staging   # build exactly what staging deploys, locally
VITE_APP_ENV=staging

# Deliberately empty: staging must not report into the live Mixpanel project.
VITE_MIXPANEL_TOKEN=
